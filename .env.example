# Variable names only. Copy to .env and fill in the values. Never put real keys in this file.
# Required means a lead run fails without it. Everything else is optional and the app labels what it skips.

# Required. Read by the Anthropic SDK itself (Planner, Qualifier and Writer, voice interpreter).
ANTHROPIC_API_KEY=
# Optional. Model for every Claude call. Default: claude-sonnet-5-5
# Left commented on purpose: an empty value here would override the default with an empty model name.
# LLM_MODEL=

# Required for GitHub discovery. Moss matches issue text to pain statements by meaning.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Needed on any machine without the gh CLI. Locally the code falls back to `gh auth token`.
GITHUB_TOKEN=

# Optional. Tavily: forum and review-site Scout, and company website lookup. Without it both are skipped.
TAVILY_API_KEY=
# Optional. Hunter: email finder and verifier. Without it no lead gets a verified address.
HUNTER_API_KEY=
# Optional. SubQ: the second model that checks claims in a draft. Without it drafts are marked unchecked.
SUBQ_API_KEY=

# Optional. Flexprice credit metering. All three are needed to leave the local wallet.
FLEXPRICE_API_KEY=
FLEXPRICE_CUSTOMER_ID=
FLEXPRICE_WALLET_ID=
# Optional. Default: https://us.api.flexprice.io/v1
FLEXPRICE_BASE_URL=
# Optional. Starting credits of the local wallet. Default: 60
LOCAL_CREDITS=

# Optional. Resend: approved messages go to DEMO_INBOX, never to the lead.
RESEND_API_KEY=
# Optional. Where redirected messages land. Default: delivered@resend.dev (Resend's test address)
DEMO_INBOX=
# Optional. Sender shown on redirected messages. Default: Earshot <onboarding@resend.dev>
MAIL_FROM=
# Optional. Google OAuth client for sending through the founder's own Gmail (still redirected, never to the lead).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Must match the Google client. Default: http://localhost:8765/api/gmail/callback
GOOGLE_REDIRECT_URI=

# Optional. ElevenLabs: spoken replies. Without them voice input still works and replies are text only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional. Path of the embedded graph database. Default: data/graph.kuzu
# Left commented on purpose: an empty value would override the default path.
# GRAPH_PATH=
